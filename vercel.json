{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.(js|css|ttf|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(manifest\\.json|sprites/.*|scenes/.*|audio/.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/realm/lecture.ts": {
      "maxDuration": 300
    },
    "api/realm/curriculum.ts": {
      "maxDuration": 300
    },
    "api/realm/study.ts": {
      "maxDuration": 120
    },
    "api/realm/calendar.ts": {
      "maxDuration": 30
    }
  }
}